{
  "version": 1,
  "id": "0001_init",
  "comment": "Batch API store, MongoDB schema version 1: small normalized collections with the invariants of the SQL schema. Integers are Int64, *_at fields are Int64 milliseconds, byte strings are generic binary. Indexes cover every query; unique indexes guard natural keys.",
  "collections": [
    "batch_quota_policy",
    "batch_quota_limits",
    "batch_catalog_revisions",
    "batch_catalog",
    "batch_quota",
    "batch_files",
    "batches",
    "batch_errors",
    "batch_items",
    "batch_claims",
    "batch_settlements",
    "batch_operations",
    "batch_schedule",
    "batch_deficits",
    "artifact_sessions"
  ],
  "indexes": [
    { "collection": "batch_quota_limits", "name": "limits_key", "keys": [["revision", 1], ["owner_id", 1]], "unique": true },
    { "collection": "batch_catalog", "name": "catalog_key", "keys": [["revision", 1], ["model_name", 1]], "unique": true },
    { "collection": "batch_files", "name": "files_list", "keys": [["owner_id", 1], ["created_at", -1], ["_id", -1]] },
    { "collection": "batch_files", "name": "files_expiry", "keys": [["state", 1], ["expires_at", 1]] },
    { "collection": "batch_files", "name": "files_gc", "keys": [["state", 1], ["gc_after", 1]] },
    { "collection": "batches", "name": "batches_list", "keys": [["owner_id", 1], ["created_at", -1], ["_id", -1]] },
    { "collection": "batches", "name": "batches_active", "keys": [["fingerprint", 1], ["status", 1], ["owner_id", 1], ["_id", 1]] },
    { "collection": "batches", "name": "batches_phase", "keys": [["status", 1], ["created_at", 1]] },
    { "collection": "batches", "name": "batches_deadline", "keys": [["status", 1], ["expires_at", 1]] },
    { "collection": "batches", "name": "batches_finalizing", "keys": [["status", 1], ["finalizing_at", 1]] },
    { "collection": "batches", "name": "batches_cleanup", "keys": [["cleanup_state", 1], ["terminal_at", 1]] },
    { "collection": "batches", "name": "batches_metadata_expiry", "keys": [["cleanup_state", 1], ["metadata_expires_at", 1]] },
    { "collection": "batch_errors", "name": "errors_key", "keys": [["owner_id", 1], ["batch_id", 1], ["seq", 1]], "unique": true },
    { "collection": "batch_items", "name": "items_key", "keys": [["owner_id", 1], ["batch_id", 1], ["line_no", 1]], "unique": true },
    { "collection": "batch_items", "name": "items_custom_id", "keys": [["owner_id", 1], ["batch_id", 1], ["custom_id", 1]], "unique": true },
    { "collection": "batch_items", "name": "items_ready", "keys": [["owner_id", 1], ["batch_id", 1], ["state", 1], ["line_no", 1]] },
    { "collection": "batch_items", "name": "items_claim", "keys": [["claim_id", 1]], "partial_string": "claim_id" },
    { "collection": "batch_claims", "name": "claims_expiry", "keys": [["kind", 1], ["state", 1], ["lease_until", 1]] },
    { "collection": "batch_claims", "name": "claims_batch", "keys": [["owner_id", 1], ["batch_id", 1]] },
    { "collection": "batch_settlements", "name": "settlements_key", "keys": [["claim_id", 1], ["line_no", 1]], "unique": true },
    { "collection": "batch_settlements", "name": "settlements_pending", "keys": [["owner_id", 1], ["accounted", 1], ["shard", 1]] },
    { "collection": "batch_settlements", "name": "settlements_owners", "keys": [["accounted", 1], ["kind", 1], ["owner_id", 1]] },
    { "collection": "batch_settlements", "name": "settlements_batch", "keys": [["owner_id", 1], ["batch_id", 1]] },
    { "collection": "batch_operations", "name": "operations_key", "keys": [["owner_id", 1], ["kind", 1], ["operation_id", 1]], "unique": true },
    { "collection": "batch_operations", "name": "operations_batch", "keys": [["owner_id", 1], ["batch_id", 1]] },
    { "collection": "batch_deficits", "name": "deficits_key", "keys": [["shard", 1], ["owner_id", 1]], "unique": true },
    { "collection": "artifact_sessions", "name": "sessions_lease", "keys": [["kind", 1], ["lease_until", 1]] },
    { "collection": "artifact_sessions", "name": "sessions_batch", "keys": [["owner_id", 1], ["batch_id", 1], ["kind", 1]] },
    { "collection": "artifact_sessions", "name": "sessions_claim", "keys": [["claim_id", 1], ["line_no", 1]], "partial_string": "claim_id" }
  ]
}
