+                                        ModelWrapper::WordPiece(model)
+                                    }
+                                    ModelTrialAfterBpe::WordLevel(model) => {
+                                        ModelWrapper::WordLevel(model)
+                                    }
+                                    ModelTrialAfterBpe::Unigram(model) => {
+                                        ModelWrapper::Unigram(model)
+                                    }
+                                }
+                            }
+                            Err(refusal) => return Ok(Err(refusal)),
+                        }
+                    }
