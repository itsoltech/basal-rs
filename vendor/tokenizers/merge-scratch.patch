+        #[serde(
+            untagged,
+            expecting = "data did not match any variant of untagged enum ModelUntagged"
+        )]
+        enum ModelTrial {
+            BPE(BpeTrial),
+            WordPiece(WordPiece),
+            WordLevel(WordLevel),
+            Unigram(Unigram),
+        }
+        #[derive(Deserialize)]
+        #[serde(
+            untagged,
+            expecting = "data did not match any variant of untagged enum ModelUntagged"
+        )]
+        enum ModelTrialAfterBpe {
+            WordPiece(WordPiece),
+            WordLevel(WordLevel),
+            Unigram(Unigram),
+        }
