+/* basal-rs: admitted-only re-sum of ops_calc_size_of_string_pool() in size_t;
+   records an overflow instead of reaching the signed int total. */
+static int
+basal_check_size_of_string_pool(regex_t* reg)
+{
+  int i;
+  int len;
+  int n;
+  size_t total;
+
+  if (IS_NULL(reg->ops)) return 0;
+
+  total = 0;
+  for (i = 0; i < (int )reg->ops_used; i++) {
+    enum OpCode opcode;
+    Operation* op;
+
+    op = reg->ops + i;
+#ifdef USE_DIRECT_THREADED_CODE
+    opcode = *(reg->ocs + i);
+#else
+    opcode = op->opcode;
+#endif
+
+    switch (opcode) {
+    case OP_STR_MBN:
+      len = op->exact_len_n.len;
+      n   = op->exact_len_n.n;
+      break;
+    case OP_STR_N:
+    case OP_STR_MB2N:
+      len = 2;
+      n   = op->exact_n.n;
+      break;
+    case OP_STR_MB3N:
+      len = 3;
+      n   = op->exact_n.n;
+      break;
+
+    default:
+      continue;
+    }
+
+    if (len < 0 || n < 0 ||
+        (len != 0 && (size_t )n > ((size_t )INT_MAX - total) / (size_t )len))
+      return onig_basal_reg_overflow(reg->basal);
+    total += (size_t )len * (size_t )n;
+  }
+
+  return 0;
+}
