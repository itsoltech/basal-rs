+/* basal-rs: admitted retained compiled backing (onig_basal.c).
+   A block is header + payload; the header stores the full block size. */
+typedef union {
+  size_t      bytes;
+  max_align_t align;
+} OnigBasalHeader;
+
+extern void*  onig_basal_reg_alloc P_((const struct OnigBasalAccount* a, size_t n));
+extern void*  onig_basal_reg_realloc P_((const struct OnigBasalAccount* a, void* p, size_t n));
+extern void*  onig_basal_reg_alloc_array P_((const struct OnigBasalAccount* a, void* p, int count, size_t elem));
+extern void   onig_basal_reg_free P_((const struct OnigBasalAccount* a, void* p));
+extern UChar* onig_basal_reg_strdup P_((const struct OnigBasalAccount* a, OnigEncoding enc, const UChar* s, const UChar* end));
+extern int    onig_basal_reg_overflow P_((const struct OnigBasalAccount* a));
+extern void   onig_basal_free_regex P_((regex_t* reg));
+
+/* The legacy branch of each dispatch is the verbatim old expression. */
+#define REG_XMALLOC(reg,n) \
+  (IS_NOT_NULL((reg)->basal) ? onig_basal_reg_alloc((reg)->basal, (n)) : xmalloc(n))
+#define REG_XREALLOC(reg,p,n) \
+  (IS_NOT_NULL((reg)->basal) ? onig_basal_reg_realloc((reg)->basal, (p), (n)) : xrealloc((p), (n)))
+#define REG_XMALLOC_ARRAY(reg,count,T) \
+  (IS_NOT_NULL((reg)->basal) ? \
+   onig_basal_reg_alloc_array((reg)->basal, NULL, (count), sizeof(T)) : \
+   xmalloc(sizeof(T) * (count)))
+#define REG_XREALLOC_ARRAY(reg,p,count,T) \
+  (IS_NOT_NULL((reg)->basal) ? \
+   onig_basal_reg_alloc_array((reg)->basal, (p), (count), sizeof(T)) : \
+   xrealloc((p), sizeof(T) * (count)))
+#define REG_XFREE(reg,p) \
+  (IS_NOT_NULL((reg)->basal) ? onig_basal_reg_free((reg)->basal, (void* )(p)) : xfree(p))
+#define REG_STRDUP(reg,s,end) \
+  (IS_NOT_NULL((reg)->basal) ? \
